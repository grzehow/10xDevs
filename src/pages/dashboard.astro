---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { MAX_BYTES, parseWeights, rankTickets, type RankedTicket, type Weights } from "@/lib/ranking";

// TODO(S-03): one generic message for every bad-file case. Give missing column, empty cell,
// wrong separator, unknown severity, duplicate id and size limit their own message (needs rankTickets to return a reason).
const FILE_ERROR =
  "Nie udało się przetworzyć pliku. Sprawdź, czy ma nagłówek ticket_id,severity,number_of_customers,number_of_services i poprawne wartości.";
const WEIGHTS_ERROR = "Nie udało się wczytać wag reguły. Spróbuj ponownie za chwilę.";

const scoreFormat = new Intl.NumberFormat("pl-PL", { minimumFractionDigits: 1, maximumFractionDigits: 2 });

const { role } = Astro.locals;
const accountLabel = role === "admin" ? "Konto administracyjne" : "Konto operatorskie";

async function rankUpload(): Promise<{ error: string } | { tickets: RankedTicket[]; weights: Weights }> {
  // formData() buffers the whole body, so refuse oversized requests first (64 KiB covers multipart overhead).
  if (Number(Astro.request.headers.get("content-length") ?? 0) > MAX_BYTES + 65_536) return { error: FILE_ERROR };

  let file: FormDataEntryValue | null;
  try {
    file = (await Astro.request.formData()).get("file");
  } catch {
    return { error: FILE_ERROR };
  }
  if (!(file instanceof File) || file.size > MAX_BYTES) return { error: FILE_ERROR };

  const supabase = createClient(Astro.request.headers, Astro.cookies);
  const result = supabase ? await supabase.from("scoring_weights").select("key, value") : null;
  const weights = result && !result.error ? parseWeights(result.data) : null;
  if (!weights) return { error: WEIGHTS_ERROR };

  const ranked = rankTickets(await file.text(), weights);
  return ranked.ok ? { tickets: ranked.tickets, weights } : { error: FILE_ERROR };
}

const outcome = Astro.request.method === "POST" ? await rankUpload() : null;
const error = outcome && "error" in outcome ? outcome.error : null;
const ranked = outcome && "tickets" in outcome ? outcome : null;
---

<Layout title="Panel">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Panel
      </h1>
      <p class="text-blue-100/80">
        Zalogowano jako: <span class="font-semibold text-white">{accountLabel}</span>
      </p>
      <p class="mt-2 text-sm text-blue-100/50">Ta strona jest dostępna tylko dla zalogowanych użytkowników.</p>
      <form method="POST" enctype="multipart/form-data" class="mt-6 flex flex-col items-center gap-3">
        <label for="file" class="text-sm text-blue-100/80">
          Wgraj plik CSV
        </label>
        <input id="file" type="file" name="file" accept=".csv,text/csv" required class="text-sm" />
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Uszereguj
        </button>
      </form>
      {error && (
        <p role="alert" class="mt-4 max-w-md text-sm text-red-200">
          {error}
        </p>
      )}
      {ranked && (
        <ol class="mt-6 space-y-1 text-left text-sm">
          {ranked.tickets.map((t) => (
            <li data-ticket-id={t.ticketId}>
              <details class="group">
                {/* A flex summary drops the native marker, so the ▸ is the only "expands" cue. */}
                <summary class="flex cursor-pointer list-none gap-4 [&::-webkit-details-marker]:hidden">
                  <span aria-hidden="true" class="text-blue-100/60 transition-transform group-open:rotate-90">
                    ▸
                  </span>
                  <span class="w-8 text-blue-100/60">{t.rank}.</span>
                  <span class="flex-1 font-mono">{t.ticketId}</span>
                  <span class="font-semibold">{scoreFormat.format(t.score)}</span>
                </summary>
                <ul class="mt-1 mb-2 ml-16 space-y-0.5 text-blue-100/80">
                  <li data-component="severity">
                    Krytyczność: {t.severity} = {scoreFormat.format(t.points.severity)}
                  </li>
                  <li data-component="customers">
                    Klienci: {t.customers} × {scoreFormat.format(ranked.weights.customer)} ={" "}
                    {scoreFormat.format(t.points.customers)}
                  </li>
                  <li data-component="services">
                    Usługi: {t.services} × {scoreFormat.format(ranked.weights.service)} ={" "}
                    {scoreFormat.format(t.points.services)}
                  </li>
                </ul>
              </details>
            </li>
          ))}
        </ol>
      )}
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Wyloguj się
        </button>
      </form>
    </div>
  </div>
</Layout>
